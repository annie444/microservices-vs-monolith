---
import '../styles/global.css';
import Icons from '../components/Icons.astro';
interface Props {
	title?: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title ? `${title} · Articles` : 'Articles'}</title>
	</head>
	<body class="mx-auto max-w-2xl px-4">
		<Icons />
		<header class="flex items-center justify-between py-5">
			<a href="/" class="font-serif text-2xl italic tracking-tight hover:text-accent">Articles</a>
			<nav id="nav-auth" class="flex items-center gap-5 text-sm text-mute"></nav>
		</header>
		<main class="pb-20"><slot /></main>
	</body>
</html>

<script>
	import { me, esc, ico } from '../lib/api';
	const link = (href: string, icon: string, label: string) =>
		`<a href="${href}" class="meta-item hover:text-ink">${ico(icon)}${label}</a>`;
	const p = await me();
	document.getElementById('nav-auth')!.innerHTML = p
		? link('/write', 'pen-line', 'Write') + link('/profiles/me', 'user-round', esc(p.name))
		: link('/login', 'log-in', 'Log in');
</script>
