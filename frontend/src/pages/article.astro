---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Article">
	<article id="article"><p>Loading…</p></article>
	<section>
		<h2>Comments</h2>
		<form id="comment-form" hidden>
			<textarea name="content" rows="3" required maxlength="2000" placeholder="Say something"
			></textarea>
			<button>Post</button>
			<p class="error"></p>
		</form>
		<ul id="comments" class="cards"></ul>
		<p id="cstatus"></p>
		<button id="more" hidden>Load more</button>
	</section>
</Layout>

<script>
	import {
		$,
		api,
		esc,
		when,
		qs,
		me,
		onSubmit,
		type Article,
		type Comment,
		type Comments,
	} from '../lib/api';

	const id = qs('id');
	if (!id) location.replace('/');
	const user = await me();

	function renderArticle(a: Article) {
		$('#article').innerHTML = `
			<h1>${esc(a.title)}</h1>
			${a.subtitle ? `<p>${esc(a.subtitle)}</p>` : ''}
			<small>
				by <a href="/profile?id=${a.creator.id}">${esc(a.creator.name)}</a>
				${a.creator.pronouns ? `(${esc(a.creator.pronouns)})` : ''} · ${when(a.created_at)}
				${a.tags.length ? ' · ' + a.tags.map(esc).join(', ') : ''}
				${user?.id === a.creator.id ? ` · <a href="/write?id=${a.id}">edit</a>` : ''}
			</small>
			<div class="content">${esc(a.content)}</div>
			<button id="fav" ${user ? '' : 'disabled title="Log in to favorite"'}>
				${a.favorited ? '♥' : '♡'} ${a.favorites}
			</button>`;
		$('#fav').onclick = async () => {
			const r = await api<{ favorites: number }>(`/articles/${a.id}/favorite`, {
				method: a.favorited ? 'DELETE' : 'POST',
			});
			renderArticle({ ...a, favorited: !a.favorited, favorites: r.favorites });
		};
	}

	function commentHtml(c: Comment, canDelete: boolean) {
		return `
			<li class="card" data-id="${c.id}">
				<small><a href="/profile?id=${c.author.id}">${esc(c.author.name)}</a> · ${when(c.created_at)}
				${canDelete ? ` · <button class="del" data-id="${c.id}">delete</button>` : ''}</small>
				<p class="content">${esc(c.content)}</p>
			</li>`;
	}

	const list = $('#comments');
	const more = $<HTMLButtonElement>('#more');
	const status = $('#cstatus');
	let cursor: string | null = null;

	let article: Article;
	try {
		article = await api<Article>(`/articles/${id}`);
		renderArticle(article);
	} catch (e) {
		$('#article').innerHTML = `<p class="error">${esc((e as Error).message)}</p>`;
		throw e;
	}

	const canDelete = (c: Comment) =>
		!!user && (user.id === c.author.id || user.id === article.creator.id);

	async function loadComments() {
		more.hidden = true;
		status.textContent = 'Loading…';
		try {
			const page = await api<Comments>(`/comments/${id}${cursor ? `?cursor=${cursor}` : ''}`);
			list.insertAdjacentHTML(
				'beforeend',
				page.comments.map((c) => commentHtml(c, canDelete(c))).join(''),
			);
			cursor = page.pagination.next_cursor;
			more.hidden = !page.pagination.has_more;
			status.textContent = list.children.length ? '' : 'No comments yet.';
		} catch (e) {
			status.textContent = (e as Error).message;
		}
	}

	list.onclick = async (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button.del');
		if (!btn) return;
		await api(`/comments/${id}/${btn.dataset.id}`, { method: 'DELETE' });
		list.querySelector(`li[data-id="${btn.dataset.id}"]`)?.remove();
		if (!list.children.length) status.textContent = 'No comments yet.';
	};

	const form = $<HTMLFormElement>('#comment-form');
	form.hidden = !user;
	onSubmit(
		form,
		(data) => api<Comment>(`/comments/${id}`, { method: 'POST', json: data }),
		(c) => {
			// New comments sort last (uuidv7 ids), so append only once every page is loaded.
			if (more.hidden) list.insertAdjacentHTML('beforeend', commentHtml(c, true));
			status.textContent = '';
			form.reset();
		},
	);

	more.onclick = loadComments;
	loadComments();
</script>
