---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Feed">
	<h1 class="font-serif text-4xl tracking-tight">Feed</h1>
	<ul id="feed" class="mt-6 divide-y divide-line"></ul>
	<p id="status" class="status mt-6"></p>
	<button id="more" class="btn mt-6" hidden>Load more</button>
</Layout>

<script>
	import { $, api, esc, ico, when, type Feed } from '../lib/api';

	const list = $('#feed');
	const more = $<HTMLButtonElement>('#more');
	const status = $('#status');
	let cursor: string | null = null;

	async function load() {
		more.hidden = true;
		status.textContent = 'Loading…';
		try {
			const feed = await api<Feed>(`/articles/feed${cursor ? `?cursor=${cursor}` : ''}`);
			list.insertAdjacentHTML(
				'beforeend',
				feed.articles
					.map(
						(a) => `
				<li class="py-6">
					<a href="/articles/${a.id}" class="font-serif text-2xl leading-tight hover:text-accent">${esc(a.title)}</a>
					${a.subtitle ? `<p class="mt-1 font-serif text-lg text-mute">${esc(a.subtitle)}</p>` : ''}
					<div class="meta mt-3">
						<a href="/profiles/${a.creator.id}" class="meta-item hover:text-ink">${ico('user-round')}${esc(a.creator.name)}</a>
						<span class="meta-item">${ico('calendar')}${when(a.created_at)}</span>
						<span class="meta-item">${ico('heart')}${a.favorites}</span>
						${a.tags.length ? `<span class="meta-item">${ico('tag')}${a.tags.map(esc).join(', ')}</span>` : ''}
					</div>
				</li>`,
					)
					.join(''),
			);
			cursor = feed.pagination.next_cursor;
			more.hidden = !feed.pagination.has_more;
			status.textContent = list.children.length ? '' : 'Nothing here yet. Be the first to write.';
		} catch (e) {
			status.textContent = (e as Error).message;
		}
	}

	more.onclick = load;
	load();
</script>
