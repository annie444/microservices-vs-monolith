---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Log in">
	<form id="login" class="grid gap-3">
		<h1 class="font-serif text-4xl tracking-tight">Log in</h1>
		<input
			name="email"
			type="email"
			class="field mt-3"
			required
			autocomplete="email"
			placeholder="Email"
		/>
		<input
			name="password"
			type="password"
			class="field"
			required
			autocomplete="current-password"
			placeholder="Password"
		/>
		<button class="btn btn-primary justify-self-start">
			<Icon name="lucide:log-in" class="size-4" aria-hidden="true" /> Log in
		</button>
		<p class="error"></p>
	</form>

	<form id="register" class="mt-12 grid gap-3 border-t border-line pt-8">
		<h2 class="font-serif text-2xl tracking-tight">New here? Create an account</h2>
		<input
			name="name"
			class="field mt-3"
			required
			maxlength="100"
			autocomplete="name"
			placeholder="Display name"
		/>
		<input
			name="email"
			type="email"
			class="field"
			required
			autocomplete="email"
			placeholder="Email"
		/>
		<input
			name="password"
			type="password"
			class="field"
			required
			autocomplete="new-password"
			placeholder="Password"
		/>
		<button class="btn justify-self-start">Create account</button>
		<p class="error"></p>
	</form>
</Layout>

<script>
	import { $, api, onSubmit } from '../lib/api';

	const login = (data: Record<string, string>) =>
		api('/users/login', { method: 'POST', json: { email: data.email, password: data.password } });
	const home = () => location.assign('/');

	onSubmit($<HTMLFormElement>('#login'), login, home);
	onSubmit(
		$<HTMLFormElement>('#register'),
		async (data) => {
			await api('/users/register', { method: 'POST', json: data });
			await login(data);
		},
		home,
	);
</script>
