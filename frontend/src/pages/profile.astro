---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Profile">
	<section id="profile"><p>Loading…</p></section>
	<form id="edit" hidden>
		<h2>Edit profile</h2>
		<input name="name" required maxlength="100" placeholder="Name" />
		<input name="pronouns" maxlength="50" placeholder="Pronouns (optional)" />
		<textarea name="bio" rows="4" maxlength="1000" placeholder="Bio (optional)"></textarea>
		<button>Save</button>
		<p class="error"></p>
	</form>
</Layout>

<script>
	import { $, api, esc, qs, me, onSubmit, type Profile } from '../lib/api';

	const id = qs('id');
	const user = await me();
	if (!id && !user) location.replace('/login');

	function render(p: Profile) {
		const own = user?.id === p.id;
		$('#profile').innerHTML = `
			<h1>${esc(p.name)}</h1>
			<small>${p.pronouns ? esc(p.pronouns) + ' · ' : ''}${p.followers_count} follower${p.followers_count === 1 ? '' : 's'}</small>
			${p.bio ? `<p class="content">${esc(p.bio)}</p>` : ''}
			${own || !user ? '' : `<button id="follow">${p.following ? 'Unfollow' : 'Follow'}</button>`}`;
		const follow = document.getElementById('follow');
		if (follow)
			follow.onclick = async () => {
				const r = await api<{ followers_count: number }>(`/profiles/${p.id}/follow`, {
					method: p.following ? 'DELETE' : 'POST',
				});
				render({ ...p, following: !p.following, followers_count: r.followers_count });
			};
	}

	try {
		const p = await api<Profile>(id ? `/profiles/${id}` : '/profiles/me');
		render(p);

		if (user?.id === p.id) {
			const form = $<HTMLFormElement>('#edit');
			form.hidden = false;
			(form.elements.namedItem('name') as HTMLInputElement).value = p.name;
			(form.elements.namedItem('pronouns') as HTMLInputElement).value = p.pronouns ?? '';
			(form.elements.namedItem('bio') as HTMLTextAreaElement).value = p.bio ?? '';
			onSubmit(
				form,
				(data) =>
					api<Profile>('/profiles/me', {
						method: 'PUT',
						// Full replacement: empty fields become null rather than "".
						json: { name: data.name, pronouns: data.pronouns || null, bio: data.bio || null },
					}),
				(updated) => render({ ...updated, following: false }),
			);
		}
	} catch (e) {
		$('#profile').innerHTML = `<p class="error">${esc((e as Error).message)}</p>`;
	}
</script>
