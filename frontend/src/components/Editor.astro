---
// Article editor shared by /write (new) and /articles/[id]/edit.
import { Icon } from 'astro-icon/components';
interface Props {
	id?: string;
}
const { id } = Astro.props;
---

<form id="write" class="grid gap-3" data-id={id}>
	<h1 class="font-serif text-4xl tracking-tight">{id ? 'Edit article' : 'New article'}</h1>
	<input
		name="title"
		class="field mt-3 font-serif text-xl"
		required
		maxlength="200"
		placeholder="Title"
	/>
	<input name="subtitle" class="field font-serif" maxlength="300" placeholder="Subtitle (optional)" />
	<input name="tags" class="field" placeholder="Tags, comma separated, up to 10" />
	<textarea
		name="content"
		class="field min-h-96 font-serif text-lg leading-relaxed"
		required
		maxlength="50000"
		placeholder="Write your article"></textarea>
	<button class="btn btn-primary justify-self-start">
		<Icon name="lucide:pen-line" class="size-4" aria-hidden="true" />
		{id ? 'Save changes' : 'Publish'}
	</button>
	<p class="error"></p>
</form>

<script>
	import { $, api, me, onSubmit, type Article } from '../lib/api';

	const form = $<HTMLFormElement>('#write');
	const id = form.dataset.id || null;
	const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

	if (!(await me())) location.replace('/login');

	if (id) {
		const a = await api<Article>(`/articles/${id}`);
		field('title').value = a.title;
		field('subtitle').value = a.subtitle ?? '';
		field('tags').value = a.tags.join(', ');
		field('content').value = a.content;
	}

	onSubmit(
		form,
		(data) =>
			api<Article>(id ? `/articles/${id}` : '/articles/new', {
				method: id ? 'PUT' : 'POST',
				json: {
					title: data.title,
					subtitle: data.subtitle || null,
					content: data.content,
					tags: data.tags.split(',').map((t) => t.trim()).filter(Boolean),
				},
			}),
		(a) => location.assign(`/articles/${a.id}`),
	);
</script>
